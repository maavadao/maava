	branch = main
[submodule "apps/dashboard"]
	path = apps/dashboard
	url = https://github.com/mawadao/mawadao-agent-dashboard.git
	branch = main
[submodule "runtime/gateway"]
	path = runtime/gateway
	url = https://github.com/mawadao/mawadao-agent-gateway.git
	branch = main
[submodule "services/api"]
	path = services/api
	url = https://github.com/mawadao/mawadao-agent-api.git
	branch = main
[submodule "services/mission-control"]
	path = services/mission-control
