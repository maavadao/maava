PORT=8090
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional: default bucket + project for the storage backend.
STORAGE_DEFAULT_BUCKET=
STORAGE_PROJECT_ID=

# Shared secret callers must supply in X-Storage-Secret for write operations.
# Leave empty in development to allow unauthenticated writes.
STORAGE_API_SECRET=

