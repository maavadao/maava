# Server
PORT=3002

# GCP Cloud Run deploy
GCP_PROJECT_ID=mawadao
GCP_REGION=europe-west1
# Optional: path to Cloud Run service YAML template (default: project templates/cloud-run-service.yaml)
# CLOUD_RUN_TEMPLATE_PATH=/path/to/cloud-run-service.yaml

# Container image to deploy for each per-user backend
CLOUD_BACKEND_IMAGE=europe-west1-docker.pkg.dev/mawadao-customer-side/mawadao-platform/tenant-platform:cloud-agent

# Shared secret — frontend must send this in X-Deployer-Secret header
DEPLOYER_API_SECRET=change-this-deployer-secret

# Secrets injected into every per-user Cloud Run backend
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mawadao
JWT_SECRET=change-this-in-production
MOONSHOT_API_KEY=

# Bucket-manager integration
# URL of the mawadao-agent-storage service (creates agent workspace folders before deploy)
STORAGE_URL=http://localhost:8090
# GCS bucket where agent workspace folders are created and mounted
STORAGE_BUCKET=mawadao-agent-data
# Shared secret — must match STORAGE_API_SECRET on the mawadao-agent-storage service
# Sent as X-Storage-Secret header on every write request (POST/PUT/DELETE)
STORAGE_API_SECRET=change-this-secret
# Mount path inside the container (default: /home/node/.openclaw)
# STORAGE_MOUNT_PATH=/home/node/.openclaw

# Bucket Manager — URL and shared secret for creating GCS folders + seeding openclaw.json
STORAGE_URL=http://localhost:8090
STORAGE_API_SECRET=change-this-storage-secret

# Credentials: run `gcloud auth application-default login` (local) or set GOOGLE_APPLICATION_CREDENTIALS
# to a JSON key file. Service account needs roles/run.admin and roles/iam.serviceAccountUser

# The member space allowed to call each member's runtime
MEMBER_SPACE_URL=https://agent.mawadao.com
