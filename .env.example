PORT=8090
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional: default bucket + project for the storage backend.
BUCKET_MANAGER_DEFAULT_BUCKET=
BUCKET_MANAGER_PROJECT_ID=

# Shared secret callers must supply in X-Bucket-Manager-Secret for write operations.
# Leave empty in development to allow unauthenticated writes.
BUCKET_MANAGER_API_SECRET=

