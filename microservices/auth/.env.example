# Server Configuration
PORT=8080
ENVIRONMENT=production

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match the Authorized Redirect URI registered in Google Cloud Console.
# Register: https://auth.mawadao.com/auth/google/callback
GOOGLE_REDIRECT_URL=https://auth.mawadao.com/auth/google/callback

# Microsoft OAuth Configuration
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
# Must match the Redirect URI registered in Azure App Registration.
# Register: https://auth.mawadao.com/auth/microsoft/callback
MICROSOFT_REDIRECT_URL=https://auth.mawadao.com/auth/microsoft/callback
# Use "common" to allow any Microsoft account, or a specific tenant ID for org-only.
MICROSOFT_TENANT_ID=common

# Session Configuration
SESSION_SECRET=change-this-to-a-random-secret-key-in-production

# JWT Secret
JWT_SECRET=change-this-jwt-secret-in-production

# OIDC Provider Configuration
# Public client id used by the mawaDao frontend when starting the OIDC code flow.
OIDC_CLIENT_ID=mawadao-web
# Optional explicit issuer. Leave empty to derive from the request host (recommended for auth.mawadao.com).
OIDC_ISSUER=https://auth.mawadao.com
# Strongly recommended in production so JWKS stays stable across deploys/restarts.
# Multiline PEM values should be injected through your secret manager or deployment env.
OIDC_PRIVATE_KEY_PEM=
# Optional stable key id for the JWKS entry.
OIDC_KEY_ID=mawadao-auth-key-1

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Frontend URL — users are redirected here after Google OAuth completes.
FRONTEND_URL=https://mawadao.com

# CORS — comma-separated allowed origins.
CORS_ORIGINS=https://mawadao.com,https://www.mawadao.com
