PORT=8090
NODE_ENV=development

# Database (same Supabase maavaDao DB)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maavadao

# Telegram — Get from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=maavadao_bot
TELEGRAM_WEBHOOK_BASE_URL=https://channels.example.com
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_ALLOWED_UPDATES=message,edited_message,callback_query
TELEGRAM_PARSE_MODE=Markdown
TELEGRAM_RATE_LIMIT_PER_MINUTE=30
TELEGRAM_ENABLE_LOGIN_WIDGET=false
TELEGRAM_ENABLE_DEEP_LINK=true

# Discord — Get from Discord Developer Portal
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# WhatsApp — Get from Meta Business
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# External: base URL where this service is publicly reachable (for webhook registration)
PUBLIC_BASE_URL=https://channels.maavadao.com

# The member space (maava-dashboard): chat API and channel-linking pages
DASHBOARD_BASE_URL=https://agent.maavadao.com
